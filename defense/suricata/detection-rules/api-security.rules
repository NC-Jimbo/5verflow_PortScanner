# ==========================================
# API 기본 공격 및 정찰 탐지 규칙 (api-security.rules)
# ==========================================

# 1. API 문서 및 설정 노출 탐지
alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"API-SECURITY Exposure of Swagger UI/OpenAPI Doc"; flow:established,to_server; http.uri; content:"/swagger-ui"; nocase; sid:1000001; rev:1;)
alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"API-SECURITY Exposure of Swagger JSON/YAML"; flow:established,to_server; http.uri; pcre:"/swagger\.(json|yaml)/i"; sid:1000002; rev:1;)
alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"API-SECURITY Potential Postman Collection Leak"; flow:established,to_server; http.uri; content:".postman_collection"; nocase; sid:1000003; rev:1;)

# 2. 자동화된 보안 스캔 도구 탐지 (User-Agent 기반)
alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"API-SECURITY Tooling Detected (SQLMap)"; flow:established,to_server; http.user_agent; content:"sqlmap"; nocase; sid:1000004; rev:1;)
alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"API-SECURITY Tooling Detected (BurpSuite)"; flow:established,to_server; http.header; content:"X-Scanner: Burp"; nocase; sid:1000005; rev:1;)
alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"API-SECURITY Tooling Detected (DirBuster/Scanner)"; flow:established,to_server; http.user_agent; pcre:"/(DirBuster|Nikto|Nmap|Gobuster)/i"; sid:1000006; rev:1;)

# 3. 비정상적인 HTTP 메소드 요청
alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"API-SECURITY Unusual HTTP Method (TRACE/TRACK)"; flow:established,to_server; http.method; pcre:"/(TRACE|TRACK|CONNECT)/"; sid:1000007; rev:1;)
alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"API-SECURITY Potential WebDAV Method Usage"; flow:established,to_server; http.method; pcre:"/(PROPFIND|COPY|MOVE|LOCK|UNLOCK)/"; sid:1000008; rev:1;)

# 4. 민감한 API 정보 노출 (응답 데이터 감시)
alert http $HTTP_SERVERS any -> $EXTERNAL_NET any (msg:"API-SECURITY Potential API Key Leak in Response"; flow:established,from_server; http.response_body; content:"api_key"; nocase; pcre:"/[a-zA-Z0-9]{20,}/"; sid:1000009; rev:1;)

# 5. GraphQL 공격 (인트로스펙션 및 서비스 거부)
alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"API-SECURITY GraphQL Introspection Attempt"; flow:established,to_server; http.uri; content:"/graphql"; http.request_body; content:"__schema"; nocase; sid:1000010; rev:1;)

# 6. API 엔드포인트 무차별 대입 (Rate Limiting 징후)
# 10초 내에 /api/ 경로로 50번 이상 요청 발생 시 알람
alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"API-SECURITY Potential API Brute-force/Scanning"; flow:established,to_server; http.uri; content:"/api/"; threshold: type both, track by_src, count 50, seconds 10; sid:1000011; rev:1;)

# 7. 비정상적인 콘텐츠 타입 및 헤더 공격
alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"API-SECURITY Missing Content-Type Header in POST/PUT"; flow:established,to_server; http.method; pcre:"/(POST|PUT)/"; http.header_names; not_content:"Content-Type"; sid:1000012; rev:1;)