# ==========================================
# OWASP API Top 10 탐지 규칙 (owasp-api-top10.rules)
# ==========================================

# 1. API1:2023 Broken Object Level Authorization (BOLA)
# 다른 사용자의 리소스 ID를 무차별 대입하는 패턴 탐지
alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"OWASP-API-1 BOLA Potential ID Enumeration"; flow:established,to_server; http.uri; pcre:"/api\/v\d+\/\w+\/\d{5,}/"; threshold: type both, track by_src, count 20, seconds 10; sid:2000001; rev:1;)

# 2. API2:2023 Broken Authentication
# 잘못된 JWT 토큰 형식이나 빈 인증 헤더 탐지
alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"OWASP-API-2 Broken Auth - Invalid JWT Header"; flow:established,to_server; http.header; content:"Authorization: Bearer"; content:!"eyJ"; distance:0; sid:2000002; rev:1;)

# 3. API3:2023 Broken Object Property Level Authorization
# 관리자 권한 승격 시도 (isAdmin: true 등) 탐지
alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"OWASP-API-3 Broken Prop Auth - Admin Privilege Escalation Attempt"; flow:established,to_server; http.request_body; content:"isAdmin"; nocase; content:"true"; distance:0; sid:2000003; rev:1;)

# 4. API4:2023 Unrestricted Resource Consumption
# 대량의 페이지 요청(Pagination 공격) 탐지
alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"OWASP-API-4 Unrestricted Resource Consumption (Large Limit)"; flow:established,to_server; http.uri; pcre:"/limit=(999\d+|[1-9]\d{5,})/"; sid:2000004; rev:1;)

# 5. API5:2023 Broken Function Level Authorization (BFLA)
# 일반 사용자가 접근해서는 안 될 관리자(Admin) 경로 접근 탐지
alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"OWASP-API-5 BFLA - Unauthorized Admin Path Access"; flow:established,to_server; http.uri; pcre:"/api\/v\d+\/(admin|system|config|setup)/i"; sid:2000005; rev:1;)

# 6. API6:2023 Unrestricted Access to Sensitive Business Flows
# 짧은 시간 내에 반복적인 구매/예약 요청 탐지
alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"OWASP-API-6 Business Flow Abuse (Purchase/Booking)"; flow:established,to_server; http.uri; pcre:"/(buy|checkout|order|booking)/i"; threshold: type both, track by_src, count 10, seconds 5; sid:2000006; rev:1;)

# 7. API7:2023 Server Side Request Forgery (SSRF)
# API 파라미터를 통한 로콜호스트 또는 내부 IP 접근 시도 탐지
alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"OWASP-API-7 SSRF Attempt via API Parameter"; flow:established,to_server; http.uri; pcre:"/(url|link|src|dest)=(http|https|ftp)%3A%2F%2F(127\.0\.0\.1|localhost|169\.254\.169\.254)/i"; sid:2000007; rev:1;)

# 8. API8:2023 Security Misconfiguration
# 디버그 모드가 활성화된 API 요청 탐지
alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"OWASP-API-8 Security Misconfig - Debug Mode Enabled"; flow:established,to_server; http.uri; content:"debug=true"; nocase; sid:2000008; rev:1;)

# 9. API9:2023 Improper Inventory Management
# 구버전 API(v1 등)를 타겟으로 한 공격 시도 탐지
alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"OWASP-API-9 Improper Inventory - Access to Deprecated API"; flow:established,to_server; http.uri; content:"/api/v1/"; nocase; sid:2000009; rev:1;)

# 10. API10:2023 Unsafe Consumption of APIs
# 외부 API 연동 시 발생할 수 있는 페이로드 공격(XSS/Injection) 탐지
alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"OWASP-API-10 Unsafe Consumption - Potential XSS in API Body"; flow:established,to_server; http.request_body; content:"<script>"; nocase; sid:2000010; rev:1;)