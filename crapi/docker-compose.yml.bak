version: '3.8'

services:
  crapi-web:
    image: crapi/crapi-web:latest
    container_name: crapi-web
    ports:
      - "8888:8080"
    restart: unless-stopped
    networks:
      - crapi-net

  postgresdb:
    image: postgres:13
    container_name: postgresdb
    environment:
      POSTGRES_DB: crapi
      POSTGRES_USER: admin
      POSTGRES_PASSWORD: crapisecretpassword
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - crapi-net

networks:
  crapi-net:
    driver: bridge

volumes:
  postgres_data: